# =================================================================
# ENTERPRISE HRMS - PRODUCTION ENVIRONMENT CONFIGURATION
# =================================================================

# Server & Runtime
ENVIRONMENT=production
DEBUG=False
PORT=8000
API_V1_PREFIX=/api

# Security & Tokens
# Generate a 256-bit secure secret: `openssl rand -hex 32`
SECRET_KEY=replace_with_a_cryptographically_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Relational Database Persistence (PostgreSQL)
POSTGRES_USER=hrms_admin
POSTGRES_PASSWORD=replace_with_strong_db_password
POSTGRES_DB=enterprise_hrms_prod
DATABASE_URL=postgresql://hrms_admin:replace_with_strong_db_password@db:5432/enterprise_hrms_prod

# Secure Private File Storage
UPLOAD_DIR=/app/backend/uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# Machine Learning & AI Inference
ML_MODEL_VERSION=v1.0.0
ML_MODELS_PATH=/app/backend/ml_service/registry/models
DRIFT_DETECTION_WINDOW=100

# CORS Production Allowed Origins
CORS_ORIGINS=["https://hrms.yourcompany.com"]
